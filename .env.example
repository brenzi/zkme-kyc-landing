# Copy to .env (git-ignored). Used by mint-link.mjs only; never deployed.
ZKME_API_KEY=
ZKME_APP_ID=
# Must match your entry's "name" (or appId) in dist/config.js
KYC_CURATOR=brenzi
KYC_BASE_URL=https://kyc.kusama-vision-pop.eth.limo/
# Program from dashboard.zk.me - Configuration - zkKYC
ZKME_PROGRAM_NO=
# zkMe chain id, decimal or named (137 = Polygon); hex is rejected by the API
ZKME_CHAIN_ID=137
# Residence (Proof-of-Address) program, separate from the zkKYC one
ZKME_POA_PROGRAM_NO=
